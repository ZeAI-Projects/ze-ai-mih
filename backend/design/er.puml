    year : SMALLINT NOT NULL
    status : VARCHAR(30) NOT NULL [DRAFT/OPEN/CLOSED/COMPLETED]
    starts_at : TIMESTAMPTZ NULLABLE
    ends_at : TIMESTAMPTZ NULLABLE
    registration_opens_at : TIMESTAMPTZ NULLABLE
    registration_closes_at : TIMESTAMPTZ NULLABLE
    venue : TEXT NULLABLE
    location : VARCHAR(200) NULLABLE
    event_mode : VARCHAR(30) NULLABLE
    eligibility_text : TEXT NULLABLE
    guidelines_text : TEXT NULLABLE
    min_team_size : INT NOT NULL DEFAULT 4
    max_team_size : INT NOT NULL DEFAULT 4
    default_team_size : INT NOT NULL DEFAULT 4
