    published_at : TIMESTAMPTZ NULLABLE
    created_at : TIMESTAMPTZ
    created_by : UUID <<FK>> NULLABLE
    modified_at : TIMESTAMPTZ
    modified_by : UUID <<FK>> NULLABLE
