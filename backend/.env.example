# Create .env locally. Never commit it or send it in chat.
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Supabase → Connect: copy a PostgreSQL connection string, adapt for SQLAlchemy psycopg.
# For IPv4, Supabase's Session pooler is often suitable. URI-encode special password characters.
DATABASE_URL=postgresql+psycopg://USERNAME:URL_ENCODED_PASSWORD@DB_HOST:5432/postgres?sslmode=require
# Only configured web origins may access this API from browsers.
FRONTEND_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://localhost:5173

# Backend ONLY. Do not commit this secret or use it in Vite/Vercel browser environment.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
