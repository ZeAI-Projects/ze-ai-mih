{
  "name": "made-in-india",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run dev",
    "build": "tsc --noEmit && vite build && node scripts/create_static_routes.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "lint": "eslint src vite.config.ts playwright.config.ts tests",
    "format": "prettier --write src tests index.html vite.config.ts playwright.config.ts",
    "test": "playwright test"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
